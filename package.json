  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@sanity/client": "^8.9.0",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "sanity": "^6.17.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "groq-js": "^2.0.0",
    "tailwindcss": "^4.3.3",
